  "cards": [
    {
      "dot": "cyan",
      "title": "Three deployables",
      "items": [
        "Next.js 14 on Vercel owns auth, history and the subscriber list",
        "FastAPI on Fly.io runs the pipeline inline — no worker process",
        "chronicle-mcp ships separately as a pip-installable stdio server"
      ]
    },
    {
      "dot": "emerald",
      "title": "The pipeline",
      "items": [
        "Five agents as a LangGraph state machine in coordinator.py",
        "Credibility and analyzer run as one parallel_analysis node",
        "Every stage streams to the browser over SSE as it completes"
      ]
    },
    {
      "dot": "rose",
      "title": "Named crossings",
      "items": [
        "/mcp is never mounted without CHRONICLE_MCP_ACCESS_KEY — 404 means unconfigured",
        "The back-edge to Next.js carries a service token, not a browser cookie",
        "Both MCP surfaces expose the same six tools; test_mcp_parity.py fails on drift"
      ]
    }
  ]
