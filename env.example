# ============================================================
# LLM provider keys
# ============================================================

# OpenRouter — primary router for OpenAI + Anthropic models (required)
# https://openrouter.ai/keys
OPEN_ROUTER_KEY=your_openrouter_key_here

# Groq — used directly for the Retriever agent (Llama 3.3 70B, sub-second latency)
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here

# Google AI Studio — fallback model provider (Gemini)
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_key_here

# Anthropic — native path for the analyzer + credibility stages. Without this
# they route through OpenRouter, and if that fails they fall back to mock
# analysis and heuristic-only credibility scores.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_key_here

# NVIDIA NIM — OpenAI-compatible endpoint, free tier metered per request
# rather than capped tokens-per-minute. Used as the LLM-as-judge for the
# semantic eval layer (eval/semantic/), deliberately a different model family
# from the Gemini/Groq models the pipeline stages run on, so the judge is not
# scoring its own output. Also usable for any stage via
# ANALYZER_MODEL=nvidia/meta/llama-3.3-70b-instruct.
# https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_key_here
# JUDGE_MODEL=meta/llama-3.3-70b-instruct

# ============================================================
# Retrieval providers
# ============================================================

# Tavily — primary AI-optimized web search (recommended)
# https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Perplexity — fallback web search when Tavily is unavailable
# https://www.perplexity.ai/
PERPLEXITY_API_KEY=your_perplexity_key_here

# ============================================================
# Storage + Queue (required when running the FastAPI backend)
# ============================================================

# Neon Postgres — persistent storage for research_results
# https://neon.tech (free tier with 0.5 GB)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Upstash Redis — used for the ARQ job queue and SSE pub/sub channels
# https://upstash.com/ (free tier 10k commands/day)
# IMPORTANT: use the TCP/TLS endpoint (rediss://) not the REST URL
REDIS_URL=rediss://default:TOKEN@HOST:6379

# ============================================================
# Optional: per-agent model overrides (`provider/model`)
# ============================================================
# The provider prefix picks the SDK: groq/ -> Groq, google/ -> Gemini,
# anthropic/ -> Anthropic, anything else -> OpenRouter.
# RETRIEVER_MODEL=groq/llama-3.3-70b-versatile
# ANALYZER_MODEL=google/gemini-flash-latest
# CREDIBILITY_MODEL=groq/llama-3.3-70b-versatile
# INSIGHT_MODEL=google/gemini-flash-latest
# REPORT_MODEL=anthropic/claude-haiku-4-5
# Groq is fastest but its free tier caps at 12k tokens/min, which a report
# prompt built from ~17 sources exceeds: groq/llama-3.3-70b-versatile
#
# Keep ANALYZER/INSIGHT/REPORT on at least two different providers. Google's
# free tier is 20 requests per day PER MODEL, so pointing all three at
# google/gemini-flash-latest caps the whole system at ~6 runs/day and the
# report stage — drawing last — is the one that 429s into an empty template.

# Invoke-time safety net for every stage when its primary rate-limits or runs
# out of credit. Set to an empty string to disable. Note that OpenRouter has
# retired its `:free` model variants — a `:free` slug here now 404s on every
# call, which makes the fallback silently useless.
# OPENROUTER_FALLBACK_MODEL=openai/gpt-oss-20b

# The app probes the fallback model once at startup and logs loudly if it is
# unusable. Set this to skip that call (e.g. in tests or offline dev).
# CHRONICLE_SKIP_FALLBACK_PROBE=1

# ============================================================
# Remote MCP connector (claude.ai custom connector)
# ============================================================
# The /mcp endpoint is mounted only when BOTH a signing secret and an access
# key are present — with either missing the connector fails closed and is not
# published at all. Never commit real values.
# Signs every OAuth artifact this server issues. Falls back to JWT_SECRET.
# CHRONICLE_OAUTH_SECRET=generate_with_openssl_rand_hex_32
# Shared secret the human types into the /oauth/authorize approval screen.
# CHRONICLE_MCP_ACCESS_KEY=generate_with_openssl_rand_hex_24
# Public origin advertised in the OAuth discovery documents. Must match the
# hostname a connector actually dials or claude.ai rejects the issuer.
# CHRONICLE_PUBLIC_URL=https://multi-agent-deep-research-api.fly.dev
# Relaxes FastMCP's DNS-rebinding Host allowlist to "*". Only for debugging.
# CHRONICLE_MCP_ALLOW_ANY_HOST=1

# ============================================================
# Newsletter / audience (Next.js frontend)
# ============================================================
# Comma-separated allowlist of emails permitted to read and manage the
# subscriber list and to broadcast reports to it.
#
# IMPORTANT: when this is UNSET, isNewsletterAdmin() returns true for *every*
# authenticated user (see frontend/src/lib/subscribers.ts). That default suits
# a single-operator deployment, but subscriber emails are PII — set this
# before opening signups to a wider audience.
# NEWSLETTER_ADMIN_EMAILS=you@example.com,cofounder@example.com

# Transactional + broadcast sending. Set in the frontend environment.
# AGENTMAIL_API_KEY=your_agentmail_key_here
# AGENTMAIL_FROM_EMAIL=briefing@yourdomain.com

# Double opt-in for public sign-ups. ON unless explicitly disabled.
#
# With it on, a public sign-up is stored as PENDING and mailed a confirmation
# link; the address only becomes mailable (and only then appears in a
# broadcast) once that link is clicked. Owner-added and CSV-imported addresses
# skip this — the owner is asserting existing consent.
#
# Set to "false" ONLY for local development, where AgentMail is usually
# unconfigured and the confirmation link would just be logged to the server
# console. Leave it on everywhere else.
# NEWSLETTER_DOUBLE_OPT_IN=true

# Public origin used to build confirm, subscribe and unsubscribe links in
# emails. The subscribe CTA deep-links to ${NEXT_PUBLIC_APP_URL}/newsletter,
# the dedicated public sign-up page; the form there posts to /api/subscribe,
# and the confirmation link points at /api/subscribe/confirm?token=...
# NEXT_PUBLIC_APP_URL=https://deep-research.intelliforge.tech

# Shared secret between the FastAPI backend and the Next.js app, so the MCP
# connector can trigger a newsletter broadcast. A scheduled job holds no
# session cookie, and the frontend authenticates browsers by cookie only —
# this is the one bearer path, and it maps to a single fixed operator
# identity, never an arbitrary user. Must be the SAME value in both services.
# Unset means broadcasting is simply unavailable (fails closed).
# CHRONICLE_SERVICE_TOKEN=generate_with_openssl_rand_hex_32
# Public origin of the web app that owns the subscriber list and mail creds.
# CHRONICLE_APP_URL=https://deep-research.intelliforge.tech

# ============================================================
# Backend runtime
# ============================================================
# ENVIRONMENT=development
# PORT=8000
# Comma-separated list of CORS allowed origins. *.vercel.app preview
# origins are auto-allowed via regex in backend/main.py.
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================
# Frontend (Next.js) — set in frontend/.env.local, not here.
# NEXT_PUBLIC_API_URL=http://localhost:8000
# ============================================================
